DATABASE_URL=postgresql://username:password@localhost:5432/movie_reservation
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=300


SECRET_KEY=secret-key-change-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="Movie Reservation System"

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
MAX_SEATS_PER_BOOKING=10
MIN_CANCELLATION_HOURS=2
